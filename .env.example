# Copie este arquivo para ".env" em desenvolvimento local.
# Em produção (Vercel), configure estas mesmas variáveis no painel
# de "Environment Variables" do projeto — nunca as coloque no código ou no git.

# Connection string do MongoDB Atlas (Connect > Drivers > Node.js)
MONGO_URL=mongodb+srv://usuario:senha@homemeddb.xxxxx.mongodb.net/homemed?appName=homemedDB

# Nome do banco de dados dentro do cluster
DB_NAME=homemed

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
# Usada para reconhecimento de medicamentos por foto/código de barras
# e para o assistente de inventário.
GEMINI_API_KEY=

# Credenciais OAuth 2.0 do Google, para o botão "Continuar com Google"
# (Google Cloud Console > APIs e Serviços > Credenciais > Criar credenciais
# > ID do cliente OAuth > Aplicativo da Web).
# Em "URIs de redirecionamento autorizados", cadastre:
#   https://SEU-DOMINIO/api/auth/google/callback
# para cada domínio em que o app roda (produção, e o domínio da Vercel
# se ainda for usado para testes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: origens permitidas por CORS nas rotas /api/*.
# Ex: https://www.homemed.tech,https://homemed-prod-uqag.vercel.app
# Deixe "*" apenas em teste; restrinja em produção.
CORS_ORIGINS=*

# Opcional: origens permitidas a "enquadrar" (iframe) as páginas do app.
FRAME_ANCESTORS='self' https:
